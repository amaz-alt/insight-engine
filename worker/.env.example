# ─── Required ────────────────────────────────────────────────────────────────
# Your Lovable app URL (no trailing slash)
APP_URL=https://your-app.lovable.app
# Shared API token — copy it from the app's Settings page
WORKER_TOKEN=paste-the-token-from-settings

# ─── Local worker HTTP endpoints (/health, /version, /status) ────────────────
PORT=8787
# Bind to loopback only by default. Use 0.0.0.0 if you must reach it remotely.
BIND=127.0.0.1

# ─── Browser ────────────────────────────────────────────────────────────────
# Persistent Chrome profile — keeps the Facebook login across restarts.
PROFILE_DIR=./fb-profile
# Where Playwright's bundled Chromium lives (install.sh sets this to /opt/ms-playwright).
PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
# false only for the one-time interactive Facebook login
HEADLESS=true

# ─── Timing ─────────────────────────────────────────────────────────────────
HEARTBEAT_SECONDS=60
POLL_SECONDS=60
LOG_DIR=./logs
LOG_LEVEL=info
